VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_API_URL=http://localhost:8000

# Optional: Cloudflare R2 public bucket URL for images (e.g. https://pub-xxxx.r2.dev). Unset = bundled /images.
VITE_IMAGE_BASE_URL=

# Show "Continue with Google" on the login page. Turn on the Google provider in Supabase
# (Authentication -> Sign In / Providers) first, then set this to true.
VITE_GOOGLE_LOGIN=false
