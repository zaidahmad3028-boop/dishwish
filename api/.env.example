SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_SERVER_ONLY_LEGACY_JWT_SECRET
ALLOWED_ORIGINS=http://localhost:5173
# Image uploads go to Supabase Storage (bucket from migration 0009) using SUPABASE_URL + SUPABASE_ANON_KEY.
# Optional: a different bucket name.
SUPABASE_STORAGE_BUCKET=images
# Optional: Cloudflare R2 instead of Supabase Storage (used when all five R2_* values are set).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dishwish-images
R2_PUBLIC_URL=
